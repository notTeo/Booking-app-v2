# Base URL of the API (no trailing slash). Set in the Vercel dashboard for production.
VITE_API_URL=http://localhost:3000

# Sentry DSN for error monitoring (public, safe in the browser bundle). Only production builds report;
# set it in the Vercel dashboard for production.
VITE_SENTRY_DSN=

# Build-time only (never in the browser bundle): uploads source maps to Sentry so its stack traces are
# readable. Set both in the Vercel dashboard for Production. SENTRY_AUTH_TOKEN is a secret: an
# Organization Token from Sentry > Settings > Developer Settings. Without it no source maps are made.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
