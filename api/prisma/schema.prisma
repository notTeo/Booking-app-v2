generator client {
  provider = "prisma-client-js"
  output   = "../dist/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ShopRole {
  owner
  manager
  staff
}

enum InviteStatus {
  pending
  accepted
  expired
}

// What a shop is subscribed to. Limits live in plan.service.ts.
enum ShopPlan {
  SOLO
  TEAM
  BUSINESS
}

// TRIALING is usable until trialEndsAt; INACTIVE (and an ended trial) is
// read-only. Set by hand for now, by the payment provider later.
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  INACTIVE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELED
  NO_SHOW
}

model Shop {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  phone       String?

  formattedAddress String?

  timezone                  String   @default("Europe/Athens")
  // How many calendar days ahead customers may book (shop-local date).
  maxAdvanceDays            Int      @default(60)
  // Minutes between bookable start times (10, 15, 20 or 30).
  slotIntervalMinutes       Int      @default(30)
  // Customers may reschedule from the link in their confirmation email.
  customerRescheduleEnabled Boolean  @default(true)
  // Hours before the start time after which the customer links lock
  // (0 = until the booking starts). Owners and managers are never limited.
  cancelCutoffHours         Int      @default(1)
  rescheduleCutoffHours     Int      @default(1)
  // Email the customer a reminder this many hours before the appointment.
  reminderEnabled           Boolean  @default(true)
  reminderHoursBefore       Int      @default(24)
  // Colour set and fonts of the public booking page (utils/branding.ts).
  publicPalette             String   @default("mono")
  publicFont                String   @default("default")
  // The shop's photo on the public page. photoUrl is the cropped image that
  // is shown; the original and the crop are kept so it can be re-edited.
  // Files live in the storage bucket (services/storage.service.ts).
  photoUrl                  String?
  photoOriginalUrl          String?
  photoCrop                 Json?
  isActive                  Boolean  @default(true)
  plan                      ShopPlan           @default(TEAM)
  subscriptionStatus        SubscriptionStatus @default(ACTIVE)
  trialEndsAt               DateTime?          @db.Timestamptz(3)
  createdAt                 DateTime @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime @updatedAt @db.Timestamptz(3)

  members              UserShop[]
  shopWorkingSchedules ShopWorkingSchedule[]
  invites              ShopInvite[]
  services             Service[]
  customers            Customer[]
  bookings             Booking[]
  timeOff              TimeOff[]
  products             Product[]
}

model ShopWorkingSchedule {
  id        String    @id @default(cuid())
  shopId    String
  staffId   String? // null = shop schedule, User.id = staff member schedule
  startDate DateTime  @db.Timestamptz(3)
  endDate   DateTime? @db.Timestamptz(3)

  isActive Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  shop Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  days ShopWorkingDay[]

  @@index([shopId])
  @@index([shopId, staffId])
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

model ShopWorkingDay {
  id         String    @id @default(cuid())
  scheduleId String
  day        DayOfWeek
  isOpen     Boolean   @default(true)

  schedule ShopWorkingSchedule    @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  hours    ShopWorkingHourRange[]

  @@unique([scheduleId, day])
}

model ShopWorkingHourRange {
  id    String @id @default(cuid())
  dayId String

  startTime String
  endTime   String

  day ShopWorkingDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@index([dayId])
}

// Dated time off on top of the weekly working hours: the time it covers is not
// bookable by customers (owners and managers can still override).
model TimeOff {
  id        String   @id @default(cuid())
  shopId    String
  staffId   String? // UserShop.id; null = the whole shop
  // Date-only (UTC midnight, like ShopWorkingSchedule); endDate is the last
  // day off, inclusive.
  startDate DateTime @db.Timestamptz(3)
  endDate   DateTime @db.Timestamptz(3)
  // "HH:mm" wall-clock in the shop timezone, applied to every day in the
  // range. Both null = the whole day.
  startTime String?
  endTime   String?
  note      String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  shop  Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  staff UserShop? @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([shopId, staffId, startDate])
}

model UserShop {
  id     String   @id @default(cuid())
  userId String? // null = team member has no login yet (not-yet-accepted invite)
  shopId String
  role   ShopRole @default(staff)

  // Durable display identity for this membership, set once when the member
  // is created and never overwritten by whatever the person later registers
  // with — bookings/services already reference this row by id, not by user.
  // email is only required if/when a login invite is actually sent.
  name  String
  email String?

  canViewCustomerDetails Boolean @default(true)

  // Extra permissions the owner can give a manager; they mean nothing for
  // staff, and the owner always has both.
  canManageManagers   Boolean @default(false)
  canEditShopSettings Boolean @default(false)

  active              Boolean @default(true)
  bookableByCustomers Boolean @default(true)
  bookableInternally  Boolean @default(true)

  // Same three as Shop: the shown photo, its original and the crop.
  photoUrl         String?
  photoOriginalUrl String?
  photoCrop        Json?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop Shop  @relation(fields: [shopId], references: [id], onDelete: Cascade)

  staffServices StaffService[]
  bookings      Booking[]
  invites       ShopInvite[]
  timeOff       TimeOff[]

  @@unique([userId, shopId])
}

model Service {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name        String
  description String?
  duration    Int // minutes
  price       Int // cents
  isActive    Boolean  @default(true)
  // false = internal only: bookable by owner/staff, never shown or bookable
  // on the public page.
  showOnPublicPage Boolean @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  staffServices     StaffService[]
  bookings          Booking[]
  customerDurations CustomerServiceDuration[]
  bookingServices BookingService[]
}

model StaffService {
  id         String   @id @default(cuid())
  userShopId String
  serviceId  String
  userShop   UserShop @relation(fields: [userShopId], references: [id], onDelete: Cascade)
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@unique([userShopId, serviceId])
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  passwordHash    String?
  isVerified      Boolean   @default(false)
  // When they created their first shop, which is the only one that gets a
  // free trial (null = no shop created yet).
  trialUsedAt     DateTime? @db.Timestamptz(3)
  // The language they last signed in with (el or en); their emails use it.
  locale          String    @default("el")
  // Version of the terms accepted at registration (null = account predates
  // versioned acceptance), and when.
  termsVersion    String?
  termsAcceptedAt DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  refreshTokens          RefreshToken[]
  emailVerificationToken EmailVerificationToken?
  passwordResetToken     PasswordResetToken?
  pendingEmailChange     PendingEmailChange?
  userShops              UserShop[]
  sentInvites            ShopInvite[]            @relation("InviteCreatedBy")
  createdBookings        Booking[]               @relation("BookingCreatedBy")
  acceptedInvites        ShopInvite[]            @relation("InviteAcceptedBy")
}

model Customer {
  id        String   @id @default(cuid())
  shopId    String
  name      String
  phone     String
  email     String?
  notes     String?
  // The shop's one "Blocked" placeholder: bookings on it are blocked slots,
  // not appointments. Never listed, edited, merged or deleted as a customer.
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  shop             Shop                      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  bookings         Booking[]
  serviceDurations CustomerServiceDuration[]

  @@unique([shopId, phone])
  @@index([shopId])
}

// How long a service takes for one particular customer, when that differs
// from the service's own duration. Used for every new booking of theirs.
model CustomerServiceDuration {
  id         String   @id @default(cuid())
  customerId String
  serviceId  String
  duration   Int // minutes
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([customerId, serviceId])
  @@index([serviceId])
}

// One service of a booking. A booking has one or more, done one after another
// by the same provider; its length is their durations added up. The name,
// duration and price are copied, so the booking keeps what was agreed. The
// first (position 0) is also Booking.serviceId.
model BookingService {
  id        String   @id @default(cuid())
  bookingId String
  serviceId String
  name      String
  // Minutes it took in this booking (the customer's own duration, if any).
  duration  Int
  // In cents.
  price     Int
  position  Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([bookingId, serviceId])
  @@index([bookingId])
  @@index([serviceId])
}

// A product the shop sells and customers can reserve with a booking. Stock
// only changes by hand, or when a reservation is marked sold.
model Product {
  id               String   @id @default(cuid())
  shopId           String
  name             String
  description      String?
  // In cents, like Service.price.
  price            Int
  // Where the shop buys it. For the shop only: never in a public response.
  supplierUrl      String?
  // How many are left.
  stock            Int      @default(0)
  photoUrl         String?
  photoOriginalUrl String?
  photoCrop        Json?
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  shop            Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  bookingProducts BookingProduct[]

  @@index([shopId])
}

enum ProductSaleStatus {
  RESERVED
  SOLD
  NOT_SOLD
}

// One product reserved with a booking. The name and price are copied, so a
// booking keeps what the customer saw after the product is edited or deleted
// (productId is then null).
model BookingProduct {
  id         String            @id @default(cuid())
  bookingId  String
  productId  String?
  name       String
  unitPrice  Int
  quantity   Int
  saleStatus ProductSaleStatus @default(RESERVED)
  // How many this line took out of the product's stock when it was marked
  // sold, so that marking it not sold gives exactly that back.
  stockTaken Int               @default(0)
  createdAt  DateTime          @default(now()) @db.Timestamptz(3)

  booking Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([bookingId, productId])
  @@index([bookingId])
  @@index([productId])
}

model Booking {
  id                String        @id @default(cuid())
  shopId            String
  customerId        String
  serviceId         String
  staffId           String
  startTime         DateTime      @db.Timestamptz(3)
  endTime           DateTime      @db.Timestamptz(3)
  status            BookingStatus @default(CONFIRMED)
  notes             String?
  cancelToken       String?       @unique
  // The email typed for this booking on the public page (null = none typed,
  // or created by the shop). This booking's emails go there before the
  // customer's own address; the customer record is never changed from it.
  contactEmail      String?
  // Booking rules the owner/staff explicitly accepted when creating this
  // booking (e.g. OUTSIDE_OPENING_HOURS). Stored at creation, never recomputed.
  overriddenRules   String[]      @default([])
  // Who created it (null = public booking, or the creator was deleted).
  createdById       String?
  // Set on the booking a reschedule created; points at the booking it
  // replaced, which stays CANCELED at its old time as a reference.
  rescheduledFromId String?       @unique
  // The language it was booked in (el or en); the customer's emails use it.
  locale            String        @default("el")
  // When the reminder email went out (null = not sent).
  reminderSentAt    DateTime?     @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)

  rescheduledFrom Booking? @relation("BookingReschedule", fields: [rescheduledFromId], references: [id], onDelete: SetNull)
  rescheduledTo   Booking? @relation("BookingReschedule")
  products        BookingProduct[]
  services        BookingService[]

  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service   Service  @relation(fields: [serviceId], references: [id])
  staff     UserShop @relation(fields: [staffId], references: [id])
  createdBy User?    @relation("BookingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([shopId])
  @@index([shopId, startTime])
  @@index([staffId, startTime])
  @@index([cancelToken])
}

model RefreshToken {
  id         String   @id @default(cuid())
  token      String   @unique
  family     String
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  expiresAt  DateTime @db.Timestamptz(3)
  rememberMe Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime @db.Timestamptz(3)
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model PendingRegistration {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  passwordHash    String
  token           String    @unique
  termsVersion    String?
  termsAcceptedAt DateTime? @db.Timestamptz(3)
  expiresAt       DateTime  @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
}

model PendingEmailChange {
  id        String   @id @default(cuid())
  userId    String   @unique
  newEmail  String
  token     String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ShopInvite {
  id           String       @id @default(cuid())
  shopId       String
  userShopId   String // the placeholder team member this invite grants a login to
  email        String
  role         ShopRole     @default(staff)
  status       InviteStatus @default(pending)
  tokenHash    String       @unique
  expiresAt    DateTime     @db.Timestamptz(3)
  createdById  String
  acceptedById String?

  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  userShop   UserShop @relation(fields: [userShopId], references: [id], onDelete: Cascade)
  createdBy  User     @relation("InviteCreatedBy", fields: [createdById], references: [id])
  acceptedBy User?    @relation("InviteAcceptedBy", fields: [acceptedById], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([shopId])
  @@index([email])
  @@index([userShopId])
}
