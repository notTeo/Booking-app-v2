# Required: development | test | production. There is deliberately no default.
NODE_ENV=development

PORT=3000

# Frontend origin(s), comma-separated. All are allowed by CORS; the FIRST one is
# used for links in emails (verify, reset, invite, cancel).
# Production example: https://yourdomain.com,https://www.yourdomain.com
CLIENT_URLS=http://localhost:5173

# PostgreSQL connection string — format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://user:password@localhost:5432/booking_app

# JWT signing secrets — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# In production each must be at least 32 characters and the two must differ, or the API refuses to start.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Token lifetimes: number + s/m/h/d/w (e.g. 15m, 12h, 30d). A bare number is rejected.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Resend (https://resend.com) — sends verification, password reset, and invite emails
RESEND_API_KEY=
EMAIL_FROM=

# Dev only: redirect every invite email to this address
# INVITE_EMAIL_OVERRIDE=

# Photo storage: an S3-compatible bucket (a Railway bucket in production).
# Leave all five unset locally and photos are saved under api/.uploads/.
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
